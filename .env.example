# Copy to .env (never commit .env). All values are optional - the app works without any of them.

# Optional: enables the Gemini content engine toggle in the Content Studio.
GEMINI_API_KEY=
# Optional: override the Gemini model name.
GEMINI_MODEL=gemini-2.5-flash
# Optional: path to a specific ffmpeg binary (default: bundled imageio-ffmpeg, then PATH).
FFMPEG_BINARY=
